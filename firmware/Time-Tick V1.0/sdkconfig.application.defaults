# Normal application; the official recovery adapter adds and checks its contract.
CONFIG_PM_ENABLE=y
CONFIG_PM_PROFILING=y
CONFIG_ESP_CRYPTO_CLK_ON_DEMAND=y
# Suppress idle tick interrupts using WFI; application keeps light sleep disabled.
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_FREERTOS_IDLE_TIME_BEFORE_SLEEP=3
CONFIG_PM_TICKLESS_IDLE_WAITI=y
# CONFIG_PM_DFS_INIT_AUTO is not set
# CONFIG_ESP_IRIS_OTA is not set
CONFIG_ESP_IRIS_USB_PRODUCT="Time-Tick V1.0"
CONFIG_ESP_IRIS_TRANSPORT_USB=y
# CONFIG_ESP_IRIS_TRANSPORT_TCP is not set
CONFIG_ESP_IRIS_NVS_PARTITION_NAME="sysmeta"
CONFIG_ESP_IRIS_HEALTH_TIMEOUT_MS=45000
CONFIG_ESP_IRIS_SERVICE_PERSISTENT=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_TINYUSB_CDC_RX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_TX_BUFSIZE=1024
CONFIG_TINYUSB_CDC_EP_BUFSIZE=512
